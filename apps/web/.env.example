# Copy to .env.local for local development. These values are public: they end up in the browser bundle.

# Base URL of the StreamSync API. Leave empty to use the page's own origin.
VITE_BACKEND_URL=http://localhost:5000

# Optional JSON array of RTCIceServer objects. Add a TURN server for users behind strict firewalls.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]

# Read by docker-compose.yml. Copy this file to .env and replace the placeholder values.

# Secret for signing session tokens. Required. Use at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-string

# Browser origin of the client. Must match the address you open in the browser.
CLIENT_ORIGIN=http://localhost:8080

# Public URL of the API as the browser reaches it. Baked into the client at build time.
VITE_BACKEND_URL=http://localhost:5000

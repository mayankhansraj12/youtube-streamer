# Copy to .env for local development. Never commit the real file.

# HTTP port the API listens on.
PORT=5000

# MongoDB connection string. Required.
MONGODB_URI=mongodb://127.0.0.1:27017/streamsync

# Secret for signing session tokens. Required, at least 16 characters. Use 32 or more in production.
JWT_SECRET=replace-with-a-long-random-string

# Lifetime of session tokens, using the ms syntax (for example 12h or 7d).
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API and open realtime connections.
CLIENT_ORIGIN=http://localhost:5173

# Maximum number of participants in one room (2 to 50).
MAX_ROOM_PARTICIPANTS=12

# Login and signup attempts allowed per IP address in a 15-minute window.
AUTH_RATE_LIMIT=30

# Set when running behind a reverse proxy so client IP addresses are read correctly (0 to 10, or true/false).
# TRUST_PROXY=1

# Optional Redis URL. Set it to share realtime state between several API instances.
# REDIS_URL=redis://127.0.0.1:6379
